# ============================================
# KVN CONSTRUCTION PLATFORM
# Application Environment Configuration
# ============================================
# LOCAL DEVELOPMENT ENVIRONMENT (XAMPP)
# Update to production values before deployment.
# ============================================

# -- Database Configuration --
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kvnc_platform
DB_USER=root
DB_PASS=

# -- Application Settings --
APP_NAME="KVN Construction"
APP_URL=http://localhost/KVN_Construction/public
APP_ENV=development
APP_DEBUG=true
APP_KEY=base64:CHANGE_ME_GENERATE_RANDOM_32_CHARS_KEY=

# -- Session Configuration --
SESSION_NAME=KVNSESSID
SESSION_TIMEOUT=3600
ADMIN_SESSION_TIMEOUT=1800

# -- OTP Settings --
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_RESEND_LIMIT=3
OTP_BLOCK_MINUTES=15

# -- Rate Limiting --
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=300
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=600

# -- SMS Gateway (Primary) --
SMS_PROVIDER=twilio
SMS_API_KEY=CHANGE_ME_PRODUCTION_SMS_KEY
SMS_API_SECRET=CHANGE_ME_PRODUCTION_SMS_SECRET
SMS_FROM_NUMBER=+1234567890
SMS_ACCOUNT_SID=CHANGE_ME_TWILIO_SID

# -- Email Gateway (Fallback for OTP) --
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@kvnconstruction.com
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@kvnconstruction.com
MAIL_FROM_NAME="KVN Construction"

# -- WhatsApp API --
WHATSAPP_API_KEY=CHANGE_ME_WHATSAPP_KEY

# -- File Uploads --
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# -- Security --
CSRF_TOKEN_EXPIRY=1800
HASH_COST=12

# -- Maintenance Mode --
MAINTENANCE_MODE=false