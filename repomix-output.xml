$pipelineStages = [

    'new' =>
    [],

    'pending' =>
    [],

    'follow_up' =>
    [],

    'converted' =>
    [],

    'closed' =>
    []
];

try {

    $query = "

        SELECT
            id,
            name,
            phone,
            email,
            budget,
            lead_type,
            lead_source,
            status,
            assigned_to,
            created_at

        FROM leads

        ORDER BY id DESC
    ";

    $stmt =
    $conn->prepare($query);

    $stmt->execute();

    $leads =
    $stmt->fetchAll();

    foreach($leads as $lead){

        $status =
        strtolower(
            $lead['status']
        );

        if(

            isset(
                $pipelineStages[$status]
            )
        ){

            $pipelineStages[$status][] =
            $lead;
        }
    }

} catch(Exception $e){

    $_SESSION['error'] =
    'Failed to load pipeline data.';
}

/*
|--------------------------------------------------------------------------
| TOTAL COUNTS
|--------------------------------------------------------------------------
*/

$totalLeads = 0;

foreach($pipelineStages as $stage){

