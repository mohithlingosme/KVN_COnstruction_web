    );
}

/*
|--------------------------------------------------------------------------
| FETCH PROJECTS
|--------------------------------------------------------------------------
*/

$projects =
    $conn->query(
        "
        SELECT *
        FROM client_projects
        WHERE client_id = $clientId
        ORDER BY id DESC
        "
    );

/*
|--------------------------------------------------------------------------
| STATS
|--------------------------------------------------------------------------
*/

$totalProjects = 0;
$completedProjects = 0;
$ongoingProjects = 0;
$planningProjects = 0;
$totalBudget = 0;

if ($projects && $projects->num_rows > 0) {

    while ($calc = $projects->fetch_assoc()) {

        $totalProjects++;

        $totalBudget +=
            (float)$calc['budget'];

        if (
            $calc['project_status']
            === 'Completed'
        ) {

            $completedProjects++;
        }

        if (
            $calc['project_status']
            === 'In Progress'
        ) {

            $ongoingProjects++;
        }

        if (
            $calc['project_status']
            === 'Planning'
        ) {

            $planningProjects++;
        }
    }

    $projects->data_seek(0);
}

