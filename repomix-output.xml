require_once '../config/app.php';

require_once '../helpers/csrf.php';

require_once '../helpers/otp.php';

require_once '../helpers/sms.php';

require_once '../helpers/security.php';

require_once '../helpers/session.php';

$pageTitle = 'Phone Login | ' . APP_NAME;

/*
|--------------------------------------------------------------------------
| REDIRECT IF ALREADY LOGGED IN
|--------------------------------------------------------------------------
*/

if (isLoggedIn()) {

    if (isAdmin()) {

        header(
            'Location: admin/dashboard.php'
        );

    } else {

        header(
            'Location: client/dashboard.php'
        );
    }

    exit;
}

/*
|--------------------------------------------------------------------------
| FORM HANDLING
|--------------------------------------------------------------------------
*/

$error = '';

$success = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    /*
    |--------------------------------------------------------------------------
    | CSRF VALIDATION
    |--------------------------------------------------------------------------
    */

    validateCsrf();

    /*
    |--------------------------------------------------------------------------
    | SANITIZE PHONE
    |--------------------------------------------------------------------------
    */

    $phone = sanitizePhoneNumber(

        $_POST['phone'] ?? ''
    );

    /*
    |--------------------------------------------------------------------------
    | VALIDATE PHONE
    |--------------------------------------------------------------------------
    */

    if (!validateIndianPhone($phone)) {

        $error =
        'Enter valid phone number.';

    } else {

        /*
        |--------------------------------------------------------------------------
        | OTP BLOCK CHECK
        |--------------------------------------------------------------------------
        */

        if (isOtpBlocked($phone)) {

            $error =
            'Too many failed attempts. Try later.';

        } else {

            /*
            |--------------------------------------------------------------------------
            | CREATE OTP
            |--------------------------------------------------------------------------
            */

            $otpData =
            createPhoneOtp($phone);

            if ($otpData['success']) {

                /*
                |--------------------------------------------------------------------------
                | SEND SMS
                |--------------------------------------------------------------------------
                */

                $sms =
                sendOtpSms(

                    $phone,

                    $otpData['otp']
                );

                if ($sms['success']) {

                    /*
                    |--------------------------------------------------------------------------
                    | OTP SESSION
                    |--------------------------------------------------------------------------
                    */

                    createOtpSession($phone);

                    /*
                    |--------------------------------------------------------------------------
                    | REDIRECT TO VERIFY
                    |--------------------------------------------------------------------------
                    */

                    $_SESSION['otp_phone'] =
                    $phone;

                    header(

                        'Location: verify-phone-otp.php'
                    );

                    exit;

                } else {

                    $error =
                    $sms['message'];
                }

            } else {

                $error =
                $otpData['message'];
            }
        }
    }
}

