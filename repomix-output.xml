<?php

declare(strict_types=1);

session_start();

/*
|--------------------------------------------------------------------------
| AUTH CHECK
|--------------------------------------------------------------------------
*/

if (!isset($_SESSION['admin_id'])) {

    header('Location: ../login.php');
    exit();
}

/*
|--------------------------------------------------------------------------
| DATABASE
|--------------------------------------------------------------------------
*/

require_once '../../includes/db.php';

/*
|--------------------------------------------------------------------------
| VALIDATE ID
|--------------------------------------------------------------------------
*/

$id =
    isset($_GET['id'])
    ? (int) $_GET['id']
    : 0;

if ($id <= 0) {

    die('Invalid service ID.');
}

/*
|--------------------------------------------------------------------------
| DEFAULT VARIABLES
|--------------------------------------------------------------------------
*/

$error   = '';
$success = '';

$title       = '';
$description = '';
$image       = '';

/*
|--------------------------------------------------------------------------
| FETCH SERVICE
|--------------------------------------------------------------------------
*/

try {

    $stmt = $conn->prepare(
        "
        SELECT
            id,
            title,
            description,
            image
        FROM services
        WHERE id = ?
        LIMIT 1
        "
    );

    if (!$stmt) {

        die('Database query failed.');
    }

    $stmt->bind_param(
        'i',
        $id
    );

    $stmt->execute();

    $stmt->store_result();

    if ($stmt->num_rows !== 1) {

        die('Service not found.');
    }

    $stmt->bind_result(
        $service_id,
        $service_title,
        $service_description,
        $service_image
    );

    $stmt->fetch();

    $title =
        (string) $service_title;

    $description =
        (string) $service_description;

    $image =
        (string) $service_image;

    $stmt->close();

} catch (Throwable $e) {

    die($e->getMessage());
}

/*
|--------------------------------------------------------------------------
| UPDATE SERVICE
|--------------------------------------------------------------------------
*/

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $title =
        trim($_POST['title'] ?? '');

    $description =
        trim($_POST['description'] ?? '');

    $image =
        trim($_POST['image'] ?? '');

    /*
    |--------------------------------------------------------------------------
    | VALIDATION
    |--------------------------------------------------------------------------
    */

    if (
        $title === '' ||
        $description === '' ||
        $image === ''
    ) {

        $error =
            'Please fill all fields.';
    }

    /*
    |--------------------------------------------------------------------------
    | UPDATE QUERY
    |--------------------------------------------------------------------------
    */

    if ($error === '') {

        try {

            $update = $conn->prepare(
                "
                UPDATE services
                SET
                    title = ?,
                    description = ?,
                    image = ?
                WHERE id = ?
                "
            );

            if (!$update) {

                $error =
                    'Database update failed.';
            } else {

                $update->bind_param(
                    'sssi',
                    $title,
                    $description,
                    $image,
                    $id
                );

                if ($update->execute()) {

                    $success =
                        'Service updated successfully.';

                } else {

                    $error =
                        'Failed to update service.';
                }

                $update->close();
            }

        } catch (Throwable $e) {

            $error =
                $e->getMessage();
        }
    }
}

