    */

    if (
        $title === '' ||
        $description === '' ||
        $image === ''
    ) {

        $error =
            'Please fill all fields.';
    }

    /*
    |--------------------------------------------------------------------------
    | INSERT SERVICE
    |--------------------------------------------------------------------------
    */

    if ($error === '') {

        try {

            $stmt = $conn->prepare(
                "
                INSERT INTO services
                (
                    title,
                    description,
                    image
                )
                VALUES
                (
                    ?,
                    ?,
                    ?
                )
                "
            );

            if (!$stmt) {

                $error =
                    'Database prepare failed.';

            } else {

                $stmt->bind_param(
                    'sss',
                    $title,
                    $description,
                    $image
                );

                if ($stmt->execute()) {

                    $message =
                        'Service created successfully.';

                    $title       = '';
                    $description = '';
