    if (
        $title === '' ||
        $category === '' ||
        $image === ''
    ) {

        $error =
            'Please fill all fields.';
    }

    /*
    |--------------------------------------------------------------------------
    | INSERT PROJECT
    |--------------------------------------------------------------------------
    */

    if ($error === '') {

        try {

            $stmt = $conn->prepare(
                "
                INSERT INTO portfolio
                (
                    title,
                    category,
                    image
                )
                VALUES
                (
                    ?,
                    ?,
                    ?
                )
                "
            );

            if (!$stmt) {

                $error =
                    'Database query failed.';
            } else {

                $stmt->bind_param(
                    'sss',
                    $title,
                    $category,
                    $image
                );

                if ($stmt->execute()) {

                    $success =
                        'Portfolio project created successfully.';

                    $title    = '';
                    $category = '';
                    $image    = '';

                } else {

                    $error =
                        'Failed to create portfolio project.';
                }

                $stmt->close();
            }

        } catch (Throwable $e) {

            $error =
                $e->getMessage();
        }
    }
}

