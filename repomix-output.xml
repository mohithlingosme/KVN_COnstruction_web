        $query = "

            INSERT INTO mail_logs (

                recipient,
                subject,
                status,
                error_message,
                ip_address,
                created_at

            )

            VALUES (

                :recipient,
                :subject,
                :status,
                :error_message,
                :ip_address,
                NOW()
            )
        ";

        $stmt =
        $conn->prepare($query);

        $stmt->execute([

            ':recipient' =>
            $recipient,

            ':subject' =>
            $subject,

            ':status' =>
            $status,

            ':error_message' =>
            $error,

            ':ip_address' =>

                $_SERVER['REMOTE_ADDR']
                ?? 'Unknown'
        ]);

    } catch (Exception $e) {

        error_log(
            'Mail log failed.'
        );
    }
}

