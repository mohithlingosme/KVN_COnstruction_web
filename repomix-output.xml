<?php

declare(strict_types=1);

session_start();

/*
|--------------------------------------------------------------------------
| AUTH CHECK
|--------------------------------------------------------------------------
*/

if (!isset($_SESSION['admin_id'])) {

    header('Location: ../login.php');
    exit();
}

/*
|--------------------------------------------------------------------------
| DATABASE
|--------------------------------------------------------------------------
*/

require_once '../../includes/db.php';

/*
|--------------------------------------------------------------------------
| VALIDATE ID
|--------------------------------------------------------------------------
*/

$id =
    isset($_GET['id'])
    ? (int) $_GET['id']
    : 0;

if ($id <= 0) {

    die('Invalid portfolio ID.');
}

/*
|--------------------------------------------------------------------------
| DEFAULT VALUES
|--------------------------------------------------------------------------
*/

$error   = '';
$success = '';

$title    = '';
$category = '';
$image    = '';

/*
|--------------------------------------------------------------------------
| FETCH EXISTING PROJECT
|--------------------------------------------------------------------------
*/

try {

    $stmt = $conn->prepare(
        "
        SELECT
            id,
            title,
            category,
            image
        FROM portfolio
        WHERE id = ?
        LIMIT 1
        "
    );

    if (!$stmt) {

        die('Database query failed.');
    }

    $stmt->bind_param(
        'i',
        $id
    );

    $stmt->execute();

    $stmt->store_result();

    if ($stmt->num_rows !== 1) {

        die('Portfolio project not found.');
    }

    $stmt->bind_result(
        $project_id,
        $project_title,
        $project_category,
        $project_image
    );

    $stmt->fetch();

    $title =
        (string) $project_title;

    $category =
        (string) $project_category;

    $image =
        (string) $project_image;

    $stmt->close();

} catch (Throwable $e) {

    die($e->getMessage());
}

/*
|--------------------------------------------------------------------------
| UPDATE PROJECT
|--------------------------------------------------------------------------
*/

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $title =
        trim($_POST['title'] ?? '');

    $category =
        trim($_POST['category'] ?? '');

    $image =
        trim($_POST['image'] ?? '');

    /*
    |--------------------------------------------------------------------------
    | VALIDATION
    |--------------------------------------------------------------------------
    */

    if (
        $title === '' ||
        $category === '' ||
        $image === ''
    ) {

        $error =
            'Please fill all fields.';
    }

    /*
    |--------------------------------------------------------------------------
    | UPDATE QUERY
    |--------------------------------------------------------------------------
    */

    if ($error === '') {

        try {

            $update = $conn->prepare(
                "
                UPDATE portfolio
                SET
                    title = ?,
                    category = ?,
                    image = ?
                WHERE id = ?
                "
            );

            if (!$update) {

                $error =
                    'Database update failed.';
            } else {

                $update->bind_param(
                    'sssi',
                    $title,
                    $category,
                    $image,
                    $id
                );

                if ($update->execute()) {

                    $success =
                        'Portfolio project updated successfully.';

                } else {

                    $error =
                        'Failed to update portfolio project.';
                }

                $update->close();
            }

        } catch (Throwable $e) {

            $error =
                $e->getMessage();
        }
    }
}

