            is_featured,
            image,
            video_url,
            created_at

        FROM client_feedback

        WHERE client_id = :client_id

        ORDER BY id DESC
    ";

    $stmt =
    $conn->prepare($query);

    $stmt->execute([

        ':client_id' => $clientId
    ]);

    $feedbacks =
    $stmt->fetchAll();

} catch(Exception $e){

    $_SESSION['error'] =
    'Failed to fetch client feedback.';
}

/*
|--------------------------------------------------------------------------
| STATS
|--------------------------------------------------------------------------
