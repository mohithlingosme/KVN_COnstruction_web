<?php

/*
|--------------------------------------------------------------------------
| KVN CONSTRUCTION PLATFORM
|--------------------------------------------------------------------------
| EDIT PROJECT
|--------------------------------------------------------------------------
| File:
| /public/admin/projects/edit.php
|--------------------------------------------------------------------------
*/

require_once '../../../config/app.php';

require_once '../../../middleware/admin.php';

require_once '../../../helpers/security.php';

require_once '../../../helpers/csrf.php';

require_once '../../../helpers/session.php';

require_once '../../../helpers/rateLimiter.php';

require_once '../../../helpers/upload.php';

/*
|--------------------------------------------------------------------------
| VALIDATE PROJECT ID
|--------------------------------------------------------------------------
*/

$projectId =
(int) ($_GET['id'] ?? 0);

if ($projectId <= 0) {

    $_SESSION['error'] =
    'Invalid project ID.';

    redirect('admin/projects/index.php');
}

/*
|--------------------------------------------------------------------------
| FETCH PROJECT
|--------------------------------------------------------------------------
*/

$query = "

    SELECT *

    FROM projects

    WHERE id = :id

    LIMIT 1
";

$stmt =
$conn->prepare($query);

$stmt->execute([

    ':id' => $projectId
]);

$project =
$stmt->fetch();

if (!$project) {

    $_SESSION['error'] =
    'Project not found.';

    redirect('admin/projects/index.php');
}

/*
|--------------------------------------------------------------------------
| FETCH CLIENTS
|--------------------------------------------------------------------------
*/

$clients = [];

try {

    $clientQuery = "

        SELECT
            id,
            full_name,
            phone

        FROM users

        WHERE role = 'client'

        ORDER BY full_name ASC
    ";

    $clientStmt =
    $conn->prepare($clientQuery);

    $clientStmt->execute();

    $clients =
    $clientStmt->fetchAll();

} catch(Exception $e){}

/*
|--------------------------------------------------------------------------
| PAGE TITLE
|--------------------------------------------------------------------------
*/

$pageTitle =
'Edit Project | ' . APP_NAME;

/*
|--------------------------------------------------------------------------
| HANDLE UPDATE
|--------------------------------------------------------------------------
*/

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    validateCsrf();

    /*
    |--------------------------------------------------------------------------
    | RATE LIMIT
    |--------------------------------------------------------------------------
    */

    if (

        !checkRateLimit(

            'edit_project',

            10,

            300
        )
    ) {

        $_SESSION['error'] =
        'Too many requests.';

        redirect(

            'admin/projects/edit.php?id='
            .
            $projectId
        );
    }

    /*
    |--------------------------------------------------------------------------
    | INPUTS
    |--------------------------------------------------------------------------
    */

    $clientId =
    (int) ($_POST['client_id'] ?? 0);

    $leadId =
    (int) ($_POST['lead_id'] ?? 0);

    $projectName =
    sanitize($_POST['project_name'] ?? '');

    $projectType =
    sanitize($_POST['project_type'] ?? '');

    $location =
    sanitize($_POST['location'] ?? '');

    $description =
    sanitize($_POST['description'] ?? '');

    $budget =
    (float) ($_POST['budget'] ?? 0);

    $status =
    sanitize($_POST['status'] ?? 'pending');

    $progress =
    (int) ($_POST['progress'] ?? 0);

    $startDate =
    $_POST['start_date'] ?? null;

    $endDate =
    $_POST['end_date'] ?? null;

    /*
    |--------------------------------------------------------------------------
    | VALIDATION
    |--------------------------------------------------------------------------
    */

    if (

        empty($projectName)

        ||

        empty($projectType)

        ||

        empty($location)
    ) {

        $_SESSION['error'] =
        'Please fill all required fields.';

        redirect(

            'admin/projects/edit.php?id='
            .
            $projectId
        );
    }

    /*
    |--------------------------------------------------------------------------
    | PROJECT IMAGE
    |--------------------------------------------------------------------------
    */

    $projectImage =
    $project['project_image'];

    if (

        isset($_FILES['project_image'])

        &&

        $_FILES['project_image']['error'] === 0
    ) {

        $upload =
        uploadFile(

            $_FILES['project_image'],

            ROOT_PATH . '/uploads/projects/',

            [

                'jpg',
                'jpeg',
                'png',
                'webp'
            ]
        );

        if ($upload['success']) {

            /*
            |--------------------------------------------------------------------------
            | DELETE OLD IMAGE
            |--------------------------------------------------------------------------
            */

            if (

                !empty($project['project_image'])

                &&

                file_exists(

                    ROOT_PATH
                    .
                    '/uploads/projects/'
                    .
                    $project['project_image']
                )
            ) {

                unlink(

                    ROOT_PATH
                    .
                    '/uploads/projects/'
                    .
                    $project['project_image']
                );
            }

            $projectImage =
            $upload['filename'];

        } else {

            $_SESSION['error'] =
            $upload['message'];

            redirect(

                'admin/projects/edit.php?id='
                .
                $projectId
            );
        }
    }

    /*
    |--------------------------------------------------------------------------
    | UPDATE PROJECT
    |--------------------------------------------------------------------------
    */

    try {

        $updateQuery = "

            UPDATE projects

            SET

                client_id = :client_id,
                lead_id = :lead_id,
                project_name = :project_name,
                project_type = :project_type,
                location = :location,
                description = :description,
                budget = :budget,
                status = :status,
                progress = :progress,
                start_date = :start_date,
                end_date = :end_date,
                project_image = :project_image,
                updated_at = NOW()

            WHERE id = :id
        ";

        $updateStmt =
        $conn->prepare($updateQuery);

        $updateStmt->execute([

            ':client_id' =>
            $clientId,

            ':lead_id' =>
            $leadId,

            ':project_name' =>
            $projectName,

            ':project_type' =>
            $projectType,

            ':location' =>
            $location,

            ':description' =>
            $description,

            ':budget' =>
            $budget,

            ':status' =>
            $status,

            ':progress' =>
            $progress,

            ':start_date' =>
            $startDate,

            ':end_date' =>
            $endDate,

            ':project_image' =>
            $projectImage,

            ':id' =>
            $projectId
        ]);

        /*
        |--------------------------------------------------------------------------
        | SECURITY LOG
        |--------------------------------------------------------------------------
        */

        logSecurityEvent(

            currentUserId(),

            'project_updated',

            'info',

            'Project updated: ' . $projectName
        );

        $_SESSION['success'] =
        'Project updated successfully.';

        redirect('admin/projects/index.php');

    } catch(Exception $e){

        $_SESSION['error'] =
        'Failed to update project.';

        redirect(

            'admin/projects/edit.php?id='
            .
            $projectId
        );
    }
}

