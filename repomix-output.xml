<?php

// =====================================
// GENERATE SEO TITLE
// =====================================

function seoTitle(
    $title = '',
    $siteName = APP_NAME
)
{
    return !empty($title)

    ? $title . ' | ' . $siteName

    : $siteName;
}

// =====================================
// GENERATE META DESCRIPTION
// =====================================

function seoDescription(
    $description = '',
    $limit = 160
)
{
    $description =
    strip_tags($description);

    if(strlen($description) > $limit){

        return substr(
            $description,
            0,
            $limit
        ) . '...';
    }

    return $description;
}

// =====================================
// GENERATE SLUG
// =====================================

function generateSlug($text)
{
    $slug = strtolower($text);

    $slug = preg_replace(
        '/[^a-z0-9\s-]/',
        '',
        $slug
    );

    $slug = preg_replace(
        '/[\s-]+/',
        '-',
        $slug
    );

    return trim($slug, '-');
}

// =====================================
// CANONICAL URL
// =====================================

function canonicalUrl($path = '')
{
    return base_url($path);
}

