$quotationId =
    (int) $_GET['id'];

$clientId =
    (int) $_SESSION['client_id'];

/*
|--------------------------------------------------------------------------
| FETCH QUOTATION
|--------------------------------------------------------------------------
*/

$stmt =
    $conn->prepare(
        "
        SELECT *
        FROM client_quotations
        WHERE id = ?
        AND client_id = ?
        LIMIT 1
        "
    );

$stmt->bind_param(
    "ii",
    $quotationId,
    $clientId
);

$stmt->execute();

$result =
    $stmt->get_result();

if ($result->num_rows === 0) {

    die('Quotation not found.');
}

$quotation =
    $result->fetch_assoc();

/*
|--------------------------------------------------------------------------
| CALCULATIONS
|--------------------------------------------------------------------------
*/

$estimatedAmount =
    (float) $quotation['estimated_amount'];

