<script>

document.querySelectorAll('.pipeline-stage')

.forEach(stage => {

    new Sortable(stage, {

        group: 'estimators',

        animation: 200,

        ghostClass: 'sortable-ghost',

        onEnd: function (evt) {

            let requestId =

            evt.item.dataset.id;

            let newStage =

            evt.to.dataset.stage;

            /*
            |--------------------------------------------------------------------------
            | AJAX STATUS UPDATE
            |--------------------------------------------------------------------------
            */

            fetch(

                'update-status.php',

                {

                    method: 'POST',

                    headers: {

                        'Content-Type':
                        'application/json'
                    },

                    body: JSON.stringify({

                        request_id:
                        requestId,

                        status:
                        newStage
                    })
                }
            )

            .then(response => response.json())

            .then(data => {

                console.log(data);

            })

            .catch(error => {

                console.error(error);
            });
        }
    });
});

</script>

