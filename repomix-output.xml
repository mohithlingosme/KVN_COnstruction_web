|--------------------------------------------------------------------------
| FETCH QUOTATION
|--------------------------------------------------------------------------
*/

try {

    $query = "

        SELECT

            q.*,

            u.full_name,
            u.email,
            u.phone,

            p.project_name,
            p.location

        FROM quotations q

        LEFT JOIN users u
        ON q.client_id = u.id

        LEFT JOIN projects p
        ON q.project_id = p.id

        WHERE q.id = :id

        LIMIT 1
    ";

    $stmt =
    $conn->prepare($query);

    $stmt->execute([

        ':id' => $quotationId
    ]);

    $quotation =
