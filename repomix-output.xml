<?php

declare(strict_types=1);

session_start();

/*
|--------------------------------------------------------------------------
| AUTH CHECK
|--------------------------------------------------------------------------
*/

if (!isset($_SESSION['admin_id'])) {

    header('Location: ../login.php');
    exit();
}

/*
|--------------------------------------------------------------------------
| DATABASE CONNECTION
|--------------------------------------------------------------------------
*/

require_once '../../includes/db.php';

/*
|--------------------------------------------------------------------------
| CREATE SEO TABLE
|--------------------------------------------------------------------------
*/

$conn->query(
    "
    CREATE TABLE IF NOT EXISTS seo_settings (

        id INT AUTO_INCREMENT PRIMARY KEY,

        page_name VARCHAR(100) NOT NULL UNIQUE,

        meta_title VARCHAR(255) NOT NULL,

        meta_description TEXT NOT NULL,

        meta_keywords TEXT NOT NULL,

        canonical_url VARCHAR(255) NOT NULL,

        og_title VARCHAR(255) NOT NULL,

        og_description TEXT NOT NULL,

        og_image VARCHAR(255) NOT NULL,

        robots VARCHAR(100) NOT NULL
        DEFAULT 'index, follow',

        updated_at TIMESTAMP
        DEFAULT CURRENT_TIMESTAMP
        ON UPDATE CURRENT_TIMESTAMP

    )
    "
);

/*
|--------------------------------------------------------------------------
| INSERT DEFAULT PAGES
|--------------------------------------------------------------------------
*/

$defaultPages = [

    'home',
    'about',
    'services',
    'portfolio',
    'contact',
    'faq'

];

foreach ($defaultPages as $page) {

    $checkStmt =
        $conn->prepare(
            "
            SELECT id
            FROM seo_settings
            WHERE page_name = ?
            LIMIT 1
            "
        );

    if ($checkStmt) {

        $checkStmt->bind_param(
            's',
            $page
        );

        $checkStmt->execute();

        $checkStmt->store_result();

        if ($checkStmt->num_rows === 0) {

            $insertStmt =
                $conn->prepare(
                    "
                    INSERT INTO seo_settings
                    (

                        page_name,
                        meta_title,
                        meta_description,
                        meta_keywords,
                        canonical_url,
                        og_title,
                        og_description,
                        og_image,
                        robots

                    )
                    VALUES
                    (
                        ?, ?, ?, ?, ?, ?, ?, ?, ?
                    )
                    "
                );

            if ($insertStmt) {

                $metaTitle =
                    'KVN Construction - ' .
                    ucfirst($page);

                $metaDescription =
                    'KVN Construction professional construction services for ' .
                    $page .
                    ' page.';

                $metaKeywords =
                    'construction, builders, interiors, home construction';

                $canonicalUrl =
                    'https://example.com/' .
                    $page;

                $ogTitle =
                    $metaTitle;

                $ogDescription =
                    $metaDescription;

                $ogImage =
                    'uploads/default-og.jpg';

                $robots =
                    'index, follow';

                $insertStmt->bind_param(
                    'sssssssss',
                    $page,
                    $metaTitle,
                    $metaDescription,
                    $metaKeywords,
                    $canonicalUrl,
                    $ogTitle,
                    $ogDescription,
                    $ogImage,
                    $robots
                );

                $insertStmt->execute();

                $insertStmt->close();
            }
        }

        $checkStmt->close();
    }
}

/*
|--------------------------------------------------------------------------
| VARIABLES
|--------------------------------------------------------------------------
*/

$success = '';
$error   = '';

/*
|--------------------------------------------------------------------------
| UPDATE SEO
|--------------------------------------------------------------------------
*/

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $id =
        (int) ($_POST['id'] ?? 0);

    $metaTitle =
        trim($_POST['meta_title'] ?? '');

    $metaDescription =
        trim($_POST['meta_description'] ?? '');

    $metaKeywords =
        trim($_POST['meta_keywords'] ?? '');

    $canonicalUrl =
        trim($_POST['canonical_url'] ?? '');

    $ogTitle =
        trim($_POST['og_title'] ?? '');

    $ogDescription =
        trim($_POST['og_description'] ?? '');

    $ogImage =
        trim($_POST['og_image'] ?? '');

    $robots =
        trim($_POST['robots'] ?? '');

    /*
    |--------------------------------------------------------------------------
    | VALIDATION
    |--------------------------------------------------------------------------
    */

    if (

        $metaTitle === '' ||
        $metaDescription === '' ||
        $metaKeywords === '' ||
        $canonicalUrl === '' ||
        $ogTitle === '' ||
        $ogDescription === '' ||
        $ogImage === '' ||
        $robots === ''

    ) {

        $error =
            'Please fill all fields.';
    }

    /*
    |--------------------------------------------------------------------------
    | UPDATE DATABASE
    |--------------------------------------------------------------------------
    */

    if ($error === '') {

        try {

            $stmt =
                $conn->prepare(
                    "
                    UPDATE seo_settings
                    SET

                        meta_title       = ?,
                        meta_description = ?,
                        meta_keywords    = ?,
                        canonical_url    = ?,
                        og_title         = ?,
                        og_description   = ?,
                        og_image         = ?,
                        robots           = ?

                    WHERE id = ?
                    "
                );

            if ($stmt) {

                $stmt->bind_param(
                    'ssssssssi',
                    $metaTitle,
                    $metaDescription,
                    $metaKeywords,
                    $canonicalUrl,
                    $ogTitle,
                    $ogDescription,
                    $ogImage,
                    $robots,
                    $id
                );

                $stmt->execute();

                $stmt->close();

                $success =
                    'SEO settings updated successfully.';
            }

        } catch (Throwable $e) {

            $error =
                $e->getMessage();
        }
    }
}

/*
|--------------------------------------------------------------------------
| FETCH SEO DATA
|--------------------------------------------------------------------------
*/

$seoPages = [];

$result =
    $conn->query(
        "
        SELECT *
        FROM seo_settings
        ORDER BY id ASC
        "
    );

if ($result) {

    while (
        $row =
        $result->fetch_assoc()
    ) {

        $seoPages[] = $row;
    }
}

?>

