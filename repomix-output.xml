<?php

declare(strict_types=1);

session_start();

/*
|--------------------------------------------------------------------------
| AUTH CHECK
|--------------------------------------------------------------------------
*/

if (!isset($_SESSION['admin_id'])) {

    header('Location: ../login.php');
    exit();
}

/*
|--------------------------------------------------------------------------
| DATABASE CONNECTION
|--------------------------------------------------------------------------
*/

require_once '../../includes/db.php';

/*
|--------------------------------------------------------------------------
| CREATE FAQ TABLE
|--------------------------------------------------------------------------
*/

$conn->query(
    "
    CREATE TABLE IF NOT EXISTS faqs (

        id INT AUTO_INCREMENT PRIMARY KEY,

        question VARCHAR(255) NOT NULL,

        answer TEXT NOT NULL,

        display_order INT NOT NULL DEFAULT 0,

        status ENUM('active','inactive')
        NOT NULL DEFAULT 'active',

        created_at TIMESTAMP
        DEFAULT CURRENT_TIMESTAMP

    )
    "
);

/*
|--------------------------------------------------------------------------
| DELETE FAQ
|--------------------------------------------------------------------------
*/

if (isset($_GET['delete'])) {

    $id =
        (int) $_GET['delete'];

    $stmt =
        $conn->prepare(
            "
            DELETE FROM faqs
            WHERE id = ?
            "
        );

    if ($stmt) {

        $stmt->bind_param(
            'i',
            $id
        );

        $stmt->execute();

        $stmt->close();
    }

    header('Location: faq.php');
    exit();
}

/*
|--------------------------------------------------------------------------
| VARIABLES
|--------------------------------------------------------------------------
*/

$success = '';
$error   = '';

$editMode = false;

$editId = 0;

$question = '';
$answer = '';
$displayOrder = 0;
$status = 'active';

/*
|--------------------------------------------------------------------------
| EDIT FETCH
|--------------------------------------------------------------------------
*/

if (isset($_GET['edit'])) {

    $editMode = true;

    $editId =
        (int) $_GET['edit'];

    $stmt =
        $conn->prepare(
            "
            SELECT
                question,
                answer,
                display_order,
                status
            FROM faqs
            WHERE id = ?
            LIMIT 1
            "
        );

    if ($stmt) {

        $stmt->bind_param(
            'i',
            $editId
        );

        $stmt->execute();

        $stmt->bind_result(
            $question,
            $answer,
            $displayOrder,
            $status
        );

        $stmt->fetch();

        $stmt->close();
    }
}

/*
|--------------------------------------------------------------------------
| SAVE FAQ
|--------------------------------------------------------------------------
*/

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $question =
        trim($_POST['question'] ?? '');

    $answer =
        trim($_POST['answer'] ?? '');

    $displayOrder =
        (int) ($_POST['display_order'] ?? 0);

    $status =
        trim($_POST['status'] ?? 'active');

    $faqId =
        (int) ($_POST['faq_id'] ?? 0);

    /*
    |--------------------------------------------------------------------------
    | VALIDATION
    |--------------------------------------------------------------------------
    */

    if (
        $question === '' ||
        $answer === ''
    ) {

        $error =
            'Please fill all required fields.';
    }

    /*
    |--------------------------------------------------------------------------
    | INSERT / UPDATE
    |--------------------------------------------------------------------------
    */

    if ($error === '') {

        try {

            /*
            |--------------------------------------------------------------------------
            | UPDATE
            |--------------------------------------------------------------------------
            */

            if ($faqId > 0) {

                $stmt =
                    $conn->prepare(
                        "
                        UPDATE faqs
                        SET

                            question = ?,
                            answer = ?,
                            display_order = ?,
                            status = ?

                        WHERE id = ?
                        "
                    );

                if ($stmt) {

                    $stmt->bind_param(
                        'ssisi',
                        $question,
                        $answer,
                        $displayOrder,
                        $status,
                        $faqId
                    );

                    $stmt->execute();

                    $stmt->close();

                    $success =
                        'FAQ updated successfully.';
                }

            } else {

                /*
                |--------------------------------------------------------------------------
                | INSERT
                |--------------------------------------------------------------------------
                */

                $stmt =
                    $conn->prepare(
                        "
                        INSERT INTO faqs
                        (

                            question,
                            answer,
                            display_order,
                            status

                        )
                        VALUES
                        (
                            ?, ?, ?, ?
                        )
                        "
                    );

                if ($stmt) {

                    $stmt->bind_param(
                        'ssis',
                        $question,
                        $answer,
                        $displayOrder,
                        $status
                    );

                    $stmt->execute();

                    $stmt->close();

                    $success =
                        'FAQ added successfully.';
                }
            }

        } catch (Throwable $e) {

            $error =
                $e->getMessage();
        }
    }
}

/*
|--------------------------------------------------------------------------
| FETCH FAQS
|--------------------------------------------------------------------------
*/

$faqs = [];

$result =
    $conn->query(
        "
        SELECT *
        FROM faqs
        ORDER BY display_order ASC, id DESC
        "
    );

if ($result) {

    while (
        $row =
        $result->fetch_assoc()
    ) {

        $faqs[] = $row;
    }
}

?>

