                $feedback['status']
            )

            ===

            'approved';
        }
    )
);

$featuredFeedbacks =
count(

    array_filter(

        $feedbacks,

        function($feedback){

            return

            !empty(
                $feedback['is_featured']
            );
        }
    )
);

/*
|--------------------------------------------------------------------------
| PAGE TITLE
