| FETCH BLOGS
|--------------------------------------------------------------------------
*/

$blogs = [];

try {

    $query = "

        SELECT

            b.*,

            u.full_name AS author_name

        FROM blogs b

        LEFT JOIN users u
        ON b.author_id = u.id

        ORDER BY b.id DESC
    ";

    $stmt =
    $conn->prepare($query);

    $stmt->execute();

    $blogs =
    $stmt->fetchAll();

} catch(Exception $e){

