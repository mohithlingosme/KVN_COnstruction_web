|--------------------------------------------------------------------------
*/

$clients = [];

try {

    $clientQuery = "

        SELECT
            id,
            full_name,
            phone,
            email

        FROM users

        WHERE role = 'client'

        ORDER BY full_name ASC
    ";

    $clientStmt =
