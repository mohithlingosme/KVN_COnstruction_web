    is_numeric($_GET['delete'])
) {

    validateCsrf();

    /*
    |--------------------------------------------------------------------------
    | RATE LIMIT
    |--------------------------------------------------------------------------
    */

    if (

        !checkRateLimit(

            'delete_blog',

            10,

            300
        )
    ) {

        $_SESSION['error'] =
        'Too many delete requests.';

        redirect('admin/blogs/index.php');
    }

    $blogId =
    (int) $_GET['delete'];

    try {

        /*
        |--------------------------------------------------------------------------
        | FETCH IMAGE
        |--------------------------------------------------------------------------
        */

        $fetchQuery = "

            SELECT featured_image

            FROM blogs

            WHERE id = :id

            LIMIT 1
        ";

        $fetchStmt =
        $conn->prepare($fetchQuery);

        $fetchStmt->execute([

            ':id' => $blogId
        ]);

        $blog =
        $fetchStmt->fetch();

        /*
        |--------------------------------------------------------------------------
        | DELETE IMAGE
        |--------------------------------------------------------------------------
