if ($failCount > 0) {
    echo "\n--- FAILURES ---\n";
    foreach ($results as $r) {
        if (!$r['ok']) {
            echo "  [FAIL] {$r['area']}::{$r['method']}" . ($r['detail'] ? " - {$r['detail']}" : '') . "\n";
