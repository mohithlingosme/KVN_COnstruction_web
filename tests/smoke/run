// 28. AUTH SERVICE FLOW
// ============================================================================
echo "\n--- 28. AuthService Flow ---\n";
require_once ROOT_PATH . '/app/services/AuthService.php';
$authService = new AuthService($userRepo, $sessionRepo, $auditRepo);

// Register
$regResult = $authService->register([
    'full_name' => 'Smoke Auth User',
    'email' => 'smoke_auth_' . time() . '@test.com',
    'phone' => '98765' . substr((string)(time() + 3), -5),
    'password' => 'Test@12345',
]);
record('AuthService', 'register', ($regResult['status'] ?? false) === true, $regResult['message'] ?? '');

// Login with invalid credentials
$badLogin = $authService->loginWithCredentials('nonexistent@test.com', 'wrongpass');
record('AuthService', 'loginWithCredentials_invalid', ($badLogin['status'] ?? true) === false, 'expected failure');

// Send OTP (will fail for non-existent user)
$otpResult = $authService->sendOtp('9999999999');
record('AuthService', 'sendOtp', is_array($otpResult));

// Logout
$logoutResult = $authService->logout();
record('AuthService', 'logout', ($logoutResult['status'] ?? false) === true);

