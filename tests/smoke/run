    $marked = $otpRepo->markUsed((int)$activeOtp['id']);
    record('OtpRepository', 'markUsed', $marked);
}

$invalidated = $otpRepo->invalidateByPhone('9876500000');
record('OtpRepository', 'invalidateByPhone', $invalidated);

