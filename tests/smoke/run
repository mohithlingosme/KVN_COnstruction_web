$missingTables = [];
foreach ($requiredTables as $t) {
    if (!tableExists($tables, $t)) {
        $missingTables[] = $t;
    }
}
record('Schema', 'required_tables', empty($missingTables), empty($missingTables) ? '' : 'Missing: ' . implode(', ', $missingTables));

// Compatibility views
$requiredViews = [
    'blog_posts', 'portfolio_projects', 'client_projects', 'client_payments',
    'project_schedules', 'client_schedules', 'media_library', 'client_files',
    'otps', 'estimators', 'estimator_leads', 'active_sessions_view',
