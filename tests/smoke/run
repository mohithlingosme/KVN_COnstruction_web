echo "\n--- 2. UserRepository ---\n";
$userRepo = smoke_repo('UserRepository', $pdo);

// Create a persistent test user for all subsequent tests
$testEmail = 'smoke_' . time() . '@test.com';
$testPhone = '98765' . substr((string)time(), -5);
$testUserId = $userRepo->createUser([
    'full_name' => 'Smoke Test User',
    'email' => $testEmail,
    'phone' => $testPhone,
    'password_hash' => password_hash('Test@12345', PASSWORD_DEFAULT),
    'role' => 'client',
    'status' => 'active',
]);
record('UserRepository', 'createUser', $testUserId > 0, $testUserId > 0 ? "id={$testUserId}" : 'insert failed');

// findByPhone
$user = $userRepo->findByPhone($testPhone);
record('UserRepository', 'findByPhone', $user === null || is_array($user));

// findByEmail
$user = $userRepo->findByEmail($testEmail);
record('UserRepository', 'findByEmail', $user === null || is_array($user));

// findById
$user = $userRepo->findById($testUserId);
record('UserRepository', 'findById', $user === null || is_array($user));

// findClientByUserId
$client = $userRepo->findClientByUserId($testUserId);
record('UserRepository', 'findClientByUserId', $client === null || is_array($client));

// createGuestUser
$guestId = $userRepo->createGuestUser('98765' . substr((string)(time() + 1), -5), 'Smoke Guest');
record('UserRepository', 'createGuestUser', $guestId > 0, $guestId > 0 ? "id={$guestId}" : 'insert failed');

// getAllUsers
$users = $userRepo->getAllUsers();
record('UserRepository', 'getAllUsers', is_array($users));

// getClients
$clients = $userRepo->getClients();
record('UserRepository', 'getClients', is_array($clients));

// findClientById
$client = $userRepo->findClientById($testUserId);
record('UserRepository', 'findClientById', $client === null || is_array($client));

// updateUser
$updated = $userRepo->updateUser($testUserId, ['full_name' => 'Smoke Updated']);
record('UserRepository', 'updateUser', $updated);

// getUserActivity
$activity = $userRepo->getUserActivity($testUserId, 5);
record('UserRepository', 'getUserActivity', is_array($activity));

// saveOtp
$otpSaved = $userRepo->saveOtp($testUserId, '123456', 'login', 5);
record('UserRepository', 'saveOtp', $otpSaved);

// findActiveOtp
$activeOtp = $userRepo->findActiveOtp($testUserId, 'login');
record('UserRepository', 'findActiveOtp', $activeOtp === null || is_array($activeOtp));

// verifyOtp (should fail with wrong OTP)
$otpVerified = $userRepo->verifyOtp($testUserId, '000000', 'login');
record('UserRepository', 'verifyOtp', $otpVerified === false, 'expected false for wrong OTP');

// expireOtp
$otpExpired = $userRepo->expireOtp($testUserId, 'login');
record('UserRepository', 'expireOtp', $otpExpired);

// findByIdentifier
$found = $userRepo->findByIdentifier($testEmail);
record('UserRepository', 'findByIdentifier', $found === null || is_array($found));

// incrementFailedAttempts
$incFailed = $userRepo->incrementFailedAttempts($testUserId);
record('UserRepository', 'incrementFailedAttempts', $incFailed);

// resetFailedAttempts
$resetFailed = $userRepo->resetFailedAttempts($testUserId);
record('UserRepository', 'resetFailedAttempts', $resetFailed);

// updateLastLogin
$lastLogin = $userRepo->updateLastLogin($testUserId);
record('UserRepository', 'updateLastLogin', $lastLogin);

// getDashboardCounts
$counts = $userRepo->getDashboardCounts();
record('UserRepository', 'getDashboardCounts', is_array($counts) && isset($counts['total_users']));

// Cleanup guest user (keep test user for subsequent tests)
if ($guestId > 0) {
    $userRepo->deleteUser($guestId);
}

