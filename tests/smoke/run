    'blogs_view', 'portfolio_view', 'projects_view', 'estimators_view',
];

$missingViews = [];
foreach ($requiredViews as $v) {
    if (!tableExists($tables, $v)) {
        $missingViews[] = $v;
    }
}
record('Schema', 'compatibility_views', empty($missingViews), empty($missingViews) ? '' : 'Missing: ' . implode(', ', $missingViews));

