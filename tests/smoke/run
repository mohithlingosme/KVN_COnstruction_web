echo "\n--- 3. SessionRepository ---\n";
$sessionRepo = smoke_repo('SessionRepository', $pdo);

$testToken = 'smoke_' . bin2hex(random_bytes(16));
$sessionCreated = $sessionRepo->create($testUserId, $testToken, 'fingerprint', 'device', '127.0.0.1', 'Smoke Test', false);
record('SessionRepository', 'create', $sessionCreated);

$session = $sessionRepo->findByToken($testToken);
record('SessionRepository', 'findByToken', $session !== null);

if ($session) {
    $updated = $sessionRepo->updateActivity((int)$session['id']);
    record('SessionRepository', 'updateActivity', $updated);

    $updatedByToken = $sessionRepo->updateActivityByToken($testToken);
    record('SessionRepository', 'updateActivityByToken', $updatedByToken);
}

$sessions = $sessionRepo->findByUserId($testUserId);
record('SessionRepository', 'findByUserId', is_array($sessions));

$rememberCreated = $sessionRepo->createRememberToken($testUserId, hash('sha256', 'smoke_token_' . bin2hex(random_bytes(8))), '127.0.0.1', 'Smoke', date('Y-m-d H:i:s', time() + 86400));
record('SessionRepository', 'createRememberToken', $rememberCreated);

$deleted = $sessionRepo->deleteByToken($testToken);
record('SessionRepository', 'deleteByToken', $deleted);

