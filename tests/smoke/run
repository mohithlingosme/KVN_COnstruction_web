<?php

declare(strict_types=1);

/**
 * KVN Platform - Full Repository Smoke Matrix
 *
 * Exercises every major repository against the live MariaDB instance.
 * Reports pass/fail for each method tested.
 */

require_once __DIR__ . '/bootstrap.php';

$pdo = smoke_pdo();
$tables = smoke_tables($pdo);

$results = [];
$passCount = 0;
$failCount = 0;
$totalCount = 0;

function record(string $area, string $method, bool $ok, string $detail = ''): void
{
    global $results, $passCount, $failCount, $totalCount;
    $totalCount++;
    if ($ok) {
        $passCount++;
    } else {
        $failCount++;
    }
    $results[] = [
        'area' => $area,
        'method' => $method,
        'ok' => $ok,
        'detail' => $detail,
    ];
    $status = $ok ? 'PASS' : 'FAIL';
    echo "[{$status}] {$area}::{$method}" . ($detail ? " - {$detail}" : '') . "\n";
}

function tableExists(array $tables, string $name): bool
{
    return in_array($name, $tables, true);
}

echo "=== KVN Platform Full Repository Smoke Matrix ===\n";
echo "Connected to: " . $pdo->query('SELECT DATABASE()')->fetchColumn() . "\n";
echo "Tables found: " . count($tables) . "\n\n";

